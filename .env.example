# NizeCloud Environment

NODE_ENV=development
NIZECLOUD_ENV=local

# API
API_PORT=4000
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://nizecloud:nizecloud@localhost:5432/nizecloud

# Cache
REDIS_URL=redis://localhost:6379

# Object Storage
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=nizecloud

# Mdano Integration
MDANO_BASE_URL=
MDANO_API_VERSION=v1
MDANO_API_KEY=
